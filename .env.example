# ── Database (Supabase PostgreSQL) ─────────────────────────────
# Ambil dari Supabase Dashboard → Project Settings → Database → Connection string
# DATABASE_URL  : gunakan "Transaction pooler" (port 6543) + ?pgbouncer=true
# DIRECT_URL    : gunakan "Direct connection" (port 5432) — dipakai prisma migrate
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# ── Auth ───────────────────────────────────────────────────────
# Secret untuk menandatangani session JWT (cookie). Ganti dengan string acak panjang.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# ── Cron (opsional) ────────────────────────────────────────────
# Token pengaman endpoint /api/cron/daily-summary (dipanggil Vercel Cron / scheduler)
CRON_SECRET="ganti-dengan-token-acak"
